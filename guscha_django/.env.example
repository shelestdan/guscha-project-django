# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True

# Database (optional, using SQLite by default)
# DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email Settings
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@example.com

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=YourBotUsername

# reCAPTCHA
RECAPTCHA_PUBLIC_KEY=your-recaptcha-public-key
RECAPTCHA_PRIVATE_KEY=your-recaptcha-private-key

# API URL (for Telegram bot callbacks)
DJANGO_API_URL=http://localhost:8000

# Ngrok settings (for development with Telegram Bot)
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# JWT Settings
JWT_SECRET_KEY=your-jwt-secret-key-for-development

# Redis Settings
REDIS_URL=redis://redis:6379/0

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:80

# Frontend URL for generating links (use real domain in production, not localhost)
FRONTEND_URL=http://localhost
