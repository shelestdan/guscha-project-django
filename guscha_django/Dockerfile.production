# Оптимизированный Dockerfile для Django проекта-магазина
# Многоступенчатая сборка для уменьшения размера образа

# Стадия сборки
FROM python:3.11-slim as builder

# Метаданные образа
LABEL maintainer="guscha@example.com" \
      version="1.0" \
      description="Django e-commerce application with optimized Docker build" \
      org.opencontainers.image.source="https://github.com/shelestdan/guscha-project-django"

# Переменные окружения для оптимизации Python
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Установка системных зависимостей в одном слое
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    default-libmysqlclient-dev \
    pkg-config \
    libffi-dev \
    libssl-dev \
    libxml2-dev \
    libxslt1-dev \
    zlib1g-dev \
    libjpeg-dev \
    libopenjp2-7-dev \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Обновление pip
RUN pip install --upgrade pip setuptools wheel

# Создание виртуального окружения
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Копирование и установка зависимостей (кэшируется при неизменном requirements-full.txt)
COPY requirements-full.txt /tmp/
RUN pip install --no-cache-dir -r /tmp/requirements-full.txt

# Продакшн стадия
FROM python:3.11-slim as production

# Метаданные для продакшн образа
LABEL stage="production"

# Переменные окружения
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH" \
    APP_HOME=/app \
    DJANGO_SETTINGS_MODULE=guscha_project.settings

# Установка только runtime зависимостей
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    default-libmysqlclient-dev \
    libxml2 \
    libxslt1.1 \
    libjpeg62-turbo \
    libopenjp2-7 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Копирование виртуального окружения из стадии сборки
COPY --from=builder /opt/venv /opt/venv

# Создание пользователя app
RUN addgroup --system app && adduser --system --group app

# Установка рабочей директории
WORKDIR $APP_HOME

# Создание необходимых директорий
RUN mkdir -p $APP_HOME/static_root $APP_HOME/logs $APP_HOME/telegram_bot/logs $APP_HOME/media $APP_HOME/backups $APP_HOME/data

# Копирование файлов приложения (порядок оптимизирован для кэширования)
COPY manage.py $APP_HOME/
COPY start_django_server.py $APP_HOME/
COPY guscha_project/ $APP_HOME/guscha_project/
COPY apps/ $APP_HOME/apps/
COPY telegram_bot/ $APP_HOME/telegram_bot/
COPY templates/ $APP_HOME/templates/
COPY static/ $APP_HOME/static/

# Копирование и настройка скрипта запуска
COPY scripts/start.sh $APP_HOME/start.sh
RUN chmod +x $APP_HOME/start.sh

# Сбор статических файлов
RUN python manage.py collectstatic --noinput

# Устанавливаем права доступа для пользователя app
RUN chown -R app:app $APP_HOME
USER app

# Открытие порта
EXPOSE 8000

# Healthcheck для мониторинга состояния
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/health/', timeout=5)" || exit 1

# Запуск приложения с миграциями
CMD ["sh", "-c", "python manage.py migrate --noinput && gunicorn guscha_project.wsgi:application --bind 0.0.0.0:8000 --workers 4 --threads 2 --timeout 120 --access-logfile $APP_HOME/logs/gunicorn-access.log --error-logfile $APP_HOME/logs/gunicorn-error.log"]