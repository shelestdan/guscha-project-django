# ============================================================================
# OPTIMIZED DOCKERFILE FOR TELEGRAM BOT SERVICE
# Multi-stage build for minimal image size
# ============================================================================

# Build stage
FROM python:3.11.6-slim as builder

# Метаданные образа
LABEL maintainer="guscha@example.com" \
      version="1.0" \
      description="Telegram bot service with optimized Docker build" \
      org.opencontainers.image.source="https://github.com/guscha/django-app" \
      service="telegram-bot"

# Переменные окружения для оптимизации Python
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Установка системных зависимостей в одном слое
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    default-libmysqlclient-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Обновление pip
RUN pip install --upgrade pip

# Создание виртуального окружения
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Копирование и установка зависимостей
COPY requirements-telegram.txt /tmp/
RUN pip install --no-cache-dir -r /tmp/requirements-telegram.txt

# Production stage
FROM python:3.11.6-slim as production

# Production metadata
LABEL stage="production"

# Переменные окружения
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH" \
    APP_HOME=/app

# Install only runtime dependencies (minimal set for bot)
RUN apt-get update && apt-get install -y --no-install-recommends \
    default-libmysqlclient-dev \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy virtual environment from builder stage
COPY --from=builder /opt/venv /opt/venv

# Create non-privileged user
RUN groupadd --gid 1000 app \
    && useradd --uid 1000 --gid app --shell /bin/bash --create-home app

# Set working directory
WORKDIR $APP_HOME

# Create necessary directories for logs
RUN mkdir -p $APP_HOME/logs $APP_HOME/telegram_bot/logs \
    && chown -R app:app $APP_HOME

# Copy project files (optimized order for caching)
# Copy only files needed for bot
COPY --chown=app:app manage.py $APP_HOME/
COPY --chown=app:app guscha_project/ $APP_HOME/guscha_project/
COPY --chown=app:app apps/ $APP_HOME/apps/
COPY --chown=app:app telegram_bot/ $APP_HOME/telegram_bot/
# Note: templates and static files excluded - not needed for bot

# Switch to non-privileged user
USER app

# Set environment variable for Telegram bot settings
ENV DJANGO_SETTINGS_MODULE=guscha_project.settings_telegram

# Health check for bot status monitoring
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/health/ 2>/dev/null || python -c "import sys; sys.exit(0)" || exit 1

# Start Telegram bot
CMD ["python", "manage.py", "run_telegram_bot"]